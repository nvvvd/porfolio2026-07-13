# En-têtes Cloudflare Pages — cache + sécurité.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate

# Images : contenu figé à nom égal -> cache 1 an.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts : cache 1 an SANS revalidation. Sûr parce que chaque page appelle ses
# scripts avec un jeton de version (nv-storage.js?v=…) : l'adresse change à chaque
# modification, donc aucune version périmée ne peut être resservie.
# /! Toute modification d'un .js exige de changer ce jeton dans toutes les pages.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=2592000
