# En-têtes Cloudflare Pages — cache agressif (réduit la bande passante) + sécurité.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Images : ne changent jamais de contenu à nom égal -> cache 1 an.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts du site : cache 7 jours (revalidation rapide après un déploiement).
/*.js
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=2592000

# Pages : revalidées à chaque visite mais servies depuis le cache si inchangées.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
