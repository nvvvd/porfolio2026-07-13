# URLs en chemin pour les galeries et les photos.
# Destination SANS « .html » (/galerie, /client) : c'est la forme déjà normalisée
# par Cloudflare Pages, donc aucune redirection en chaîne n'est possible.
/galerie/*   /galerie   200
/client/*    /client    200

# Anciennes adresses -> nouvelles (SEO). Aucune réécriture vers un fichier .dc.html.
/accueil        /            301
/Accueil.dc     /            301
/Portfolio.dc   /portfolio   301
/Galerie.dc     /galerie     301
/Client.dc      /client      301
/Admin.dc       /admin       301
/Contact.dc     /contact     301
/Mentions.dc    /mentions    301
