# URLs en chemin pour les espaces client.
# Destination SANS « .html » (/client) : c'est la forme déjà normalisée par
# Cloudflare Pages, donc aucune redirection en chaîne n'est possible.
/client/*    /client    200

# ⚠ NE PAS RÉTABLIR « /galerie/*  /galerie  200 ».
# Cloudflare Pages applique _redirects AVANT les fonctions : cette règle
# court-circuitait functions/galerie/[[path]].js, qui n'était donc jamais
# appelée — tous les liens de galerie partagés affichaient la même photo.
# La fonction assure elle-même cette réécriture, en interne.

# Anciennes adresses -> nouvelles (SEO). Aucune réécriture vers un fichier .dc.html.
/accueil        /            301
/Accueil.dc     /            301
/Portfolio.dc   /portfolio   301
/Galerie.dc     /galerie     301
/Client.dc      /client      301
/Admin.dc       /admin       301
/Contact.dc     /contact     301
/Mentions.dc    /mentions    301
